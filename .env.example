# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is NEVER committed (see .gitignore).
# Values here are placeholders. Anything left blank that a feature needs will
# fail loudly at boot rather than silently using a wrong default.
# ---------------------------------------------------------------------------

APP_NAME="Bulbula"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # ignored in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Addis_Ababa

# --- Database --------------------------------------------------------------
DB_DRIVER=mysql              # mysql | sqlite   (sqlite is used by the test suite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bulbula
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SQLITE_PATH=:memory:        # used only when DB_DRIVER=sqlite

# --- Logging ---------------------------------------------------------------
LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug               # production: warning
LOG_JSON=false                # production: true

# --- Security --------------------------------------------------------------
# Networks whose forwarded client address may be believed, comma separated —
# Cloudflare's published ranges, e.g. `173.245.48.0/20,2400:cb00::/32`
# (https://www.cloudflare.com/ips-v4 and /ips-v6). Empty (the default) means
# the connecting address is the client address, which is right when nothing
# sits in front. With a proxy in front and this left empty, every visitor
# shares one address: the per-network sign-in limits cover everybody at once,
# and the audit log records the proxy as the visitor.
TRUSTED_PROXIES=

SESSION_COOKIE=bulbula_session
SESSION_LIFETIME=1200         # seconds of inactivity
SESSION_ABSOLUTE_LIFETIME=1209600   # seconds, however active the session is
CSRF_ENABLED=true
CSRF_COOKIE=bulbula_csrf

# --- Email one-time code (customer sign-in) ---------------------------------
# TRD OT-02 — Open — technical decision: these are placeholders until the
# security phase confirms them. Changing them is configuration, not code.
OTP_LENGTH=6
OTP_TTL=600                   # seconds a code stays valid (10 minutes)
OTP_MAX_ATTEMPTS=5            # failed attempts before the code is discarded
OTP_RESEND_COOLDOWN=60        # seconds before the same address may ask again

# --- Email (transactional) -------------------------------------------------
MAIL_TRANSPORT=log            # local | provider   (no provider selected yet)
                              # local: writes messages to MAIL_LOCAL_PATH and
                              #        refuses to run unless APP_ENV=local — the
                              #        only way to finish sign-in in development.
                              # provider: the transport selected under D-41.
                              # Anything else means codes are NOT deliverable,
                              # and the application refuses rather than logging
                              # a sign-in code (OTP-10).
MAIL_LOCAL_PATH=storage/tmp/mail
MAIL_FROM="Bulbula <no-reply@bulbula.et>"
MAIL_DSN=

# --- Telegram Mini App -----------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- Maps ------------------------------------------------------------------
MAPS_PROVIDER=
MAPS_API_KEY=

# --- Rate limits (per source, per window) ----------------------------------
# Only the Google bucket is tunable from the environment today; the others live
# in config/security.php and are TRD OT-02's open values.
RATE_LIMIT_GOOGLE_SIGNIN=20    # requests per 900 s, per source

# --- Google sign-in (C-30, GA-1…GA-6) ---------------------------------------
# The client id is public — it travels in the page. Several ids may be listed,
# comma separated: web, Android, iOS. Without any, the Google button is not
# rendered and email codes carry on alone.
#
# APP_URL (above) is what the page tells Google to post the credential back to,
# and Google compares it with the client's authorised redirect URIs character
# for character. So APP_URL must equal the address registered in the console as
# an authorised JavaScript origin, and APP_URL + /sign-in/google as a redirect
# URI. No client secret is needed: the credential is verified against Google's
# published keys, never exchanged.
GOOGLE_CLIENT_IDS=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs   # Google's key set
GOOGLE_KEYS_CACHE=storage/tmp/keys/google.json               # disk cache of it
GOOGLE_KEYS_TTL=3600          # seconds a cached key set is served
GOOGLE_MAX_TOKEN_AGE=600      # seconds old a credential may be
GOOGLE_CLOCK_LEEWAY=60        # seconds of tolerance on exp/iat
