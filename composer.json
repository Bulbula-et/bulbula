{
    "name": "bulbula/bulbula",
    "description": "Bulbula \u2014 a curated business directory for Addis Ababa. Plain PHP 8.4, no framework.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "nikic/fast-route": "^1.3",
        "monolog/monolog": "^3.7",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Bulbula\\Backend\\": "backend/",
            "Bulbula\\Frontend\\": "frontend/",
            "Bulbula\\Api\\": "api/",
            "Bulbula\\Admin\\": "admin/"
        },
        "files": [
            "backend/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Bulbula\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public tools/router.php",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "fix": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
