#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Bulbula console.
 *
 * The only file in the project that calls exit(): everything else returns
 * values, so every class stays testable.
 */

use Bulbula\Backend\Core\Application;

define('BASE_PATH', dirname(__DIR__));

$autoload = BASE_PATH . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Dependencies are not installed. Run: composer install\n");
    exit(1);
}

require $autoload;

try {
    $application = new Application(BASE_PATH);
    $application->boot();

    $status = $application->console()->run($argv);
} catch (Throwable $error) {
    // Boot failures happen before the runner exists — an unreadable .env, an
    // unwritable log directory, a missing extension. They must still be visible
    // on the terminal, whatever the web-facing error settings say.
    fwrite(STDERR, sprintf(
        'Bulbula could not start: %s: %s%s',
        $error::class,
        $error->getMessage(),
        PHP_EOL,
    ));

    exit(1);
}

// The only exit() in the project: every command returns a code instead.
exit($status);
